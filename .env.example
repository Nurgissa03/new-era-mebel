# Образец. Скопируйте этот файл в .env и вставьте свои значения.
# Файл .env в репозиторий не попадает (он в .gitignore).
#
# Здесь ТОЛЬКО публичные значения. Secret key / service_role сюда НЕ кладём.

# Supabase → Project Settings → Data API → Project URL
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (или legacy «anon public»)
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
